# .env.example
# LINE Bot 設定
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here
LINE_CHANNEL_SECRET=your_line_channel_secret_here

# Gemini AI 設定
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemma-4-26b-a4b-it
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_TOKENS=2048

# 資料庫設定
DATABASE_URL=postgresql://username:password@localhost:5432/database_name

# 機器人設定
MENTION_KEYWORDS=@G-bot,@G-Bot
ADMIN_USERS=Uxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PRIORITY_MENTION_NAMES=王小明,陳小美

# 外部 API 金鑰
CWA_API_KEY=your_cwa_api_key_here
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
WEATHER_API_KEY=your_weather_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here
TAVILY_SEARCH_MAX_RESULTS=5
TAVILY_SEARCH_DEPTH=basic
TAVILY_SEARCH_TOPIC=general
TAVILY_INCLUDE_ANSWER=true
TAVILY_CACHE_TTL=600

# Loading Animation 設定
ENABLE_LOADING_ANIMATION=true
LINE_LOADING_SECONDS=20

# 餐廳搜尋設定
DEFAULT_SEARCH_RADIUS=1500
NEAR_RADIUS=500
FAR_RADIUS=2500

# 地震監控設定
EARTHQUAKE_CHECK_INTERVAL=20
EARTHQUAKE_MIN_MAGNITUDE=4.0
EARTHQUAKE_MAX_LATENCY=900

# 可選設定
PORT=8787
LOG_LEVEL=INFO
CORS_ALLOW_ORIGINS=
